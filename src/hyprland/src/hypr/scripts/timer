#!/usr/bin/env bash

ALARMAUDIOFILE_PATH="$HOME/.config/assets/media/audi/PhantomStartingScene.mp3"

time=$(rofi -dmenu -p 'Timer')

if [ -z "$time" ]; then
	exit 0
fi

# message="$(rofi -dmenu -p 'Message')"
# if [ -z "$message" ]; then
#    exit 2
# fi

sleep "$time"
notify-send "$time up!"
mpv --no-video --really-quiet "$ALARMAUDIOFILE_PATH"
